[internationalization]

locale/translations=PackedStringArray("res://localization/translations.cs.translation", "res://localization/translations.en.translation")

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemies"
3d_physics/layer_4="anchors"
3d_physics/layer_5="props"
3d_physics/layer_6="projectiles"
3d_physics/layer_7="triggers"
3d_physics/layer_8="one_way_2d"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

textures/vram_compression/import_etc2_astc=true
